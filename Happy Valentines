<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Pretty Valentine</title>

<link href="https://fonts.googleapis.com/css2?family=Comic+Neue:wght@400;700&display=swap" rel="stylesheet">

<style>
:root{
  --pink:#ff4fa3;
  --softPink:#ffc6e2;
  --text:#6b3a5c;
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:"Comic Neue",cursive;
}

body{
  min-height:100vh;
  display:flex;
  justify-content:center;
  align-items:center;
  overflow-x:hidden;
  overflow-y:auto;
}

.background{
  position:fixed;
  inset:0;
  z-index:-3;
  overflow:hidden;
}

.background img{
  width:100%;
  height:100%;
  object-fit:cover;
  filter:blur(10px) brightness(0.85);
  transform:scale(1.08);
}

.background::after{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(-45deg,#ffd6e8aa,#e9ddffaa,#ffc6e2aa,#f5e9ffaa);
  background-size:400% 400%;
  animation:bgMove 20s ease infinite;
}

@keyframes bgMove{
  0%{background-position:0% 50%;}
  50%{background-position:100% 50%;}
  100%{background-position:0% 50%;}
}

.petal{
  position:fixed;
  top:-10%;
  animation:fall linear infinite;
  pointer-events:none;
  opacity:.8;
  z-index:-1;
}

@keyframes fall{
  to{transform:translateY(120vh) rotate(360deg);}
}

.question{
  background:rgba(255,255,255,.92);
  padding:50px 60px;
  border-radius:40px;
  box-shadow:0 30px 80px rgba(255,105,180,.35);
  text-align:center;
  backdrop-filter:blur(10px);
  animation:float 4s ease-in-out infinite;
  transition:.6s ease;
}

@keyframes float{
  0%,100%{transform:translateY(0);}
  50%{transform:translateY(-10px);}
}

.question h1{
  color:var(--pink);
  font-size:32px;
  margin-bottom:30px;
}

.buttons{
  display:flex;
  gap:25px;
  justify-content:center;
}

button{
  padding:15px 40px;
  border:none;
  border-radius:40px;
  font-size:18px;
  cursor:pointer;
  color:white;
  background:linear-gradient(135deg,var(--pink),var(--softPink));
  box-shadow:0 15px 35px rgba(255,105,180,.4);
  transition:.3s ease;
}

button:hover{ transform:scale(1.1); }

#yes{ animation:pulse 1.7s infinite; }

@keyframes pulse{
  0%,100%{box-shadow:0 0 15px rgba(255,79,163,.5);}
  50%{box-shadow:0 0 30px rgba(255,79,163,1);}
}

.fade-out{
  opacity:0;
  transform:scale(.95);
}

.wrapper{
  display:none;
  opacity:0;
  transform:scale(.95);
  transition:.8s ease;
}

.wrapper.show{
  opacity:1;
  transform:scale(1);
}

.envelope{
  width:260px;
  height:170px;
  background:white;
  border-radius:15px;
  position:relative;
  cursor:pointer;
  overflow:hidden;
  box-shadow:0 20px 50px rgba(255,105,180,.4);
  transition:all .6s cubic-bezier(.68,-0.55,.27,1.55);
}

.envelope.expand{
  width:500px;
  height:auto;
  border-radius:25px;
  box-shadow:0 40px 120px rgba(255,79,163,.5);
  padding-bottom:30px;
}

@media(max-width:600px){
  .envelope.expand{
    width:90vw;
  }
}

.flap{
  position:absolute;
  width:100%;
  height:100%;
  background:linear-gradient(135deg,var(--pink),var(--softPink));
  clip-path:polygon(0 0,50% 60%,100% 0);
  transform-origin:top;
  transition:1s;
  z-index:2;
}

.envelope.expand .flap{
  transform:rotateX(180deg);
}

.letter{
  opacity:0;
  padding:30px 40px;
  margin-top:20px;
  transition:.6s ease;
}

.envelope.expand .letter{
  opacity:1;
}

.letter h2{
  color:var(--pink);
  margin-bottom:15px;
}

.letter p span{
  display:block;
  opacity:0;
  transform:translateY(15px);
  animation:fadeLine .8s forwards;
}

.letter p {
  white-space: pre-wrap; 
}


@keyframes fadeLine{
  to{
    opacity:1;
    transform:translateY(0);
  }
}

.heart{
  position:fixed;
  font-size:22px;
  pointer-events:none;
  animation:explode 1s forwards ease-out;
}

@keyframes explode{
  0%{opacity:1;transform:translate(0,0) scale(1);}
  100%{opacity:0;transform:translate(var(--x),var(--y)) scale(1.8);}
}

.sparkle{
  position:fixed;
  pointer-events:none;
  font-size:12px;
  animation:sparkleFade .8s linear forwards;
}

@keyframes sparkleFade{
  0%{opacity:1; transform:scale(1);}
  100%{opacity:0; transform:scale(0);}
}

.background.dim img{
  filter:blur(12px) brightness(0.6);
  transition:filter .6s ease;
}

.envelope::before{
  content:"";
  position:absolute;
  inset:-20px;
  background:radial-gradient(circle, rgba(255,79,163,.35), transparent 70%);
  opacity:0;
  transition:opacity .6s ease;
  z-index:-1;
  border-radius:30px;
}

.envelope.expand::before{
  opacity:1;
}

</style>
</head>

<body>

<div class="background">
  <img src="denden.jpg" alt="Our Photo">
</div>

<audio id="bgMusic" loop>
  <source src="leehi.mp3" type="audio/mpeg">
</audio>

<div class="question" id="question">
  <h1>Will you be my Valentine?</h1>
  <div class="buttons">
    <button id="yes">Yes</button>
    <button id="no">No</button>
  </div>
</div>

<div class="wrapper" id="wrapper">
  <div class="envelope" id="envelope">
    <div class="flap"></div>
    <div class="letter">
      <h2>Happy Valentine’s Day, Shieldene!</h2>
      <p id="letterText">

How are you? I know things haven’t been easy between us,
and I understand you’ve been carrying a lot
on your mind and heart.

I just want you to know that I still care about
you deeply. Also, if there were times I didn’t fully understand you or show up the way I should’ve… 
I’ve thought about that a lot. You deserve someone who’s patient with you and to be really seen and heard.

I’m always proud of you — of your strength,
your heart, and the way you keep going
even when things feel heavy.

If someday there’s a chance for us to truly
understand each other better,
I’m open to that.

For now, I hope today brings you peace
and lightness.

I just hope this made you smile, even a little :>
I hope you also liked the flower, st4rgaz3_0!! ^^

I’d love to hold your hand again… would you be my Valentine, Shieldene?
      </p>
    </div>
  </div>
</div>

<script>
const yes=document.getElementById("yes");
const no=document.getElementById("no");
const question=document.getElementById("question");
const wrapper=document.getElementById("wrapper");
const envelope=document.getElementById("envelope");
const music=document.getElementById("bgMusic");

yes.onclick=()=>{
  question.classList.add("fade-out");
  setTimeout(()=>{
    question.style.display="none";
    wrapper.style.display="block";
    setTimeout(()=>wrapper.classList.add("show"),50);
    music.play();
  },600);
};

no.style.transition = "transform 0.4s ease";

no.onmouseover = () => {
  const moveX = (Math.random() - 0.2) * 500;
  const moveY = (Math.random() - 0.2) * 320;

  no.style.transform = `translate(${moveX}px, ${moveY}px)`;
};

const background = document.querySelector(".background");

envelope.onclick = () => {
  envelope.classList.toggle("expand");
  background.classList.toggle("dim");
  explodeHearts();
  animateLetter();
};

function explodeHearts(){
  const hearts=["💖","💗","💕","💘","💞"];
  for(let i=0;i<25;i++){
    const h=document.createElement("div");
    h.className="heart";
    h.textContent=hearts[Math.floor(Math.random()*hearts.length)];
    h.style.left="50%";
    h.style.top="50%";
    h.style.setProperty("--x",(Math.random()-0.5)*600+"px");
    h.style.setProperty("--y",(Math.random()-0.5)*400+"px");
    document.body.appendChild(h);
    setTimeout(()=>h.remove(),1000);
  }
}

function animateLetter() {
  const paragraph = document.getElementById("letterText");
  if (paragraph.dataset.animated) return;

  const fullText = paragraph.innerText.trim();
  paragraph.innerHTML = "";

  let i = 0;
  function type() {
    if (i < fullText.length) {
      paragraph.innerHTML += fullText.charAt(i) === "\n" ? "<br>" : fullText.charAt(i);
      i++;
      setTimeout(type, 40);
    } else {
      paragraph.dataset.animated = "true";
    }
  }
  type();
}


const flowers=["🌸","💮","🌺"];
for(let i=0;i<75;i++){
  const p=document.createElement("div");
  p.className="petal";
  p.textContent=flowers[Math.floor(Math.random()*flowers.length)];
  p.style.left=Math.random()*100+"vw";
  p.style.fontSize=16+Math.random()*24+"px";
  p.style.animationDuration=6+Math.random()*6+"s";
  document.body.appendChild(p);
}

document.addEventListener("mousemove",e=>{
  const sparkle=document.createElement("div");
  sparkle.className="sparkle";
  sparkle.textContent="✨";
  sparkle.style.left=e.pageX+"px";
  sparkle.style.top=e.pageY+"px";
  document.body.appendChild(sparkle);
  setTimeout(()=>sparkle.remove(),800);
});
</script>

</body>
</html>
